{
  "name": "ai-quiz-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "tsc": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down -v",
    "test:integration": "pnpm test:db:up && DIRECT_URL=postgresql://test:test@localhost:5434/quriosity_test prisma migrate deploy && vitest run -c vitest.integration.config.mts",
    "postinstall": "prisma generate",
    "migrate": "dotenv -e .env.local -- prisma migrate dev",
    "migrate:deploy": "dotenv -e .env.production -- prisma migrate deploy",
    "gen:quiz": "dotenv -e .env.local -- node scripts/generate-quiz.mjs",
    "cleanup:demo": "dotenv -e .env.local -- node scripts/cleanup-demo-users.mjs",
    "cleanup:demo:prod": "dotenv -e .env.production -- node scripts/cleanup-demo-users.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.65",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.5.0",
    "ai": "^6.0.191",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.577.0",
    "next": "16.1.7",
    "next-auth": "5.0.0-beta.30",
    "pg": "^8.20.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "shadcn": "^4.0.8",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.7",
    "eslint-plugin-import": "^2.32.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "prisma": "^7.5.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.9"
  }
}
